{
  "name": "medjugorje-messages-pwa",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "test:ui:browser": "python3 scripts/check-reader-browser.py",
    "build:search-metadata": "node scripts/build-search-metadata.mjs",
    "check:search-metadata": "node scripts/build-search-metadata.mjs --check",
    "test:search": "node --test tests/search/*.test.mjs",
    "test:search:browser": "python3 scripts/check-search-browser.py --output /tmp/medjugorje-search-browser.json",
    "benchmark:search": "node --expose-gc scripts/benchmark-search.mjs",
    "benchmark:search:browser": "python3 scripts/check-search-browser.py --benchmark",
    "predev": "node scripts/stage-data.mjs",
    "dev": "vite --host 0.0.0.0",
    "prebuild": "node scripts/stage-data.mjs",
    "build": "vite build",
    "preview": "vite preview --host 0.0.0.0",
    "check:data": "node scripts/check-data.mjs",
    "build:private": "npm run check:data && SITE_BASE=/ npm run build",
    "test:preview": "python3 scripts/check-preview.py"
  },
  "dependencies": {
    "vue": "^3.5.18",
    "vuetify": "^3.10.0"
  },
  "devDependencies": {
    "@vitejs/plugin-vue": "^6.0.1",
    "vite": "^7.1.0",
    "vite-plugin-pwa": "^1.0.2"
  }
}
